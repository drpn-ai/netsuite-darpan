<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-114: NetSuite auth profile services that need netsuite-darpan's token and SuiteQL code, which darpan
     (where NsAuthConfig and its save service live) cannot reach — netsuite-darpan depends on darpan, not the
     other way round. The `facade.` path keeps it inside the DARPAN_APP artifact group's `facade\..*` pattern. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="probe" noun="NsAuthConnection" allow-remote="false" authenticate="true">
        <description>Connection diagnostics for a saved NetSuite OAuth2 auth profile. Registered on the
            SourceSystemConnector NETSUITE row as healthCheckServiceName and invoked only through
            facade.SettingsFacadeServices.test#SourceConnection, which owns the permission gate.
            Read-only: one token and a one-row SuiteQL query. Never writes to ec.message: a refused
            credential is a check row, not a service error.</description>
        <implements service="reconciliation.SourceConnectorContractServices.define#SourceConnectionProbe"/>
        <in-parameters>
            <parameter name="nsAuthConfigId" required="true"/>
        </in-parameters>
        <actions>
            <script>context.putAll(netsuite.facade.NsConnectionProbe.probeConnection(ec, nsAuthConfigId, stage))</script>
        </actions>
    </service>

</services>

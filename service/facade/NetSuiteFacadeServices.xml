<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="list" noun="NsAuthConfigs" allow-remote="false" authenticate="true">
        <description>List NetSuite auth configurations with secret indicators.</description>
        <in-parameters>
            <parameter name="query"/>
            <parameter name="pageIndex" type="Integer" default-value="0"/>
            <parameter name="pageSize" type="Integer" default-value="20"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages"><parameter name="message"/></parameter>
            <parameter name="errors"><parameter name="error"/></parameter>
            <parameter name="pagination">
                <parameter name="pageIndex" type="Integer"/>
                <parameter name="pageSize" type="Integer"/>
                <parameter name="totalCount" type="Integer"/>
                <parameter name="pageCount" type="Integer"/>
            </parameter>
            <parameter name="authConfigs">
                <parameter name="nsAuthConfigId"/>
                <parameter name="description"/>
                <parameter name="authType"/>
                <parameter name="username"/>
                <parameter name="tokenUrl"/>
                <parameter name="clientId"/>
                <parameter name="certId"/>
                <parameter name="scope"/>
                <parameter name="isActive"/>
                <parameter name="hasPassword" type="Boolean"/>
                <parameter name="hasApiToken" type="Boolean"/>
                <parameter name="hasPrivateKeyPem" type="Boolean"/>
            </parameter>
        </out-parameters>
        <actions>
            <set field="pageIndexSafe" from="Math.max(0, darpan.facade.common.FacadeSupport.normalizeInt(pageIndex, 0))"/>
            <set field="pageSizeSafe" from="Math.max(1, Math.min(200, darpan.facade.common.FacadeSupport.normalizeInt(pageSize, 20)))"/>
            <set field="searchLower" from="darpan.facade.common.FacadeSupport.normalize(query)?.toLowerCase()"/>
            <set field="authConfigs" from="[]"/>
            <set field="pagination" from="[pageIndex: pageIndexSafe, pageSize: pageSizeSafe, totalCount: 0, pageCount: 1]"/>
            <entity-find entity-name="darpan.reconciliation.NsAuthConfig" list="nsAuthConfigList" cache="false">
                <order-by field-name="description,nsAuthConfigId"/>
            </entity-find>
            <set field="rows" from="(nsAuthConfigList ?: []).collect { cfg -> [nsAuthConfigId: cfg.nsAuthConfigId, description: cfg.description, authType: cfg.authType ?: 'NONE', username: cfg.username, tokenUrl: cfg.tokenUrl, clientId: cfg.clientId, certId: cfg.certId, scope: cfg.scope ?: 'restlets rest_webservices', isActive: cfg.isActive ?: 'Y', hasPassword: cfg.password ? true : false, hasApiToken: cfg.apiToken ? true : false, hasPrivateKeyPem: cfg.privateKeyPem ? true : false] }"/>
            <set field="filteredRows" from="searchLower ? rows.findAll { row -> [row.nsAuthConfigId, row.description, row.authType, row.username].any { it?.toString()?.toLowerCase()?.contains(searchLower) } } : rows"/>
            <set field="totalCount" from="filteredRows.size()"/>
            <set field="fromIndex" from="Math.min(pageIndexSafe * pageSizeSafe, totalCount)"/>
            <set field="toIndex" from="Math.min(fromIndex + pageSizeSafe, totalCount)"/>
            <set field="authConfigs" from="filteredRows.subList(fromIndex, toIndex)"/>
            <set field="pagination" from="[pageIndex: pageIndexSafe, pageSize: pageSizeSafe, totalCount: totalCount, pageCount: Math.max(1, ((totalCount + pageSizeSafe - 1) / pageSizeSafe) as int)]"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="save" noun="NsAuthConfig" allow-remote="false" authenticate="true">
        <description>Create or update a NetSuite auth configuration.</description>
        <in-parameters>
            <parameter name="nsAuthConfigId" required="true"/>
            <parameter name="description"/>
            <parameter name="authType" default-value="NONE"/>
            <parameter name="username"/>
            <parameter name="password"/>
            <parameter name="apiToken"/>
            <parameter name="tokenUrl"/>
            <parameter name="clientId"/>
            <parameter name="certId"/>
            <parameter name="scope" default-value="restlets rest_webservices"/>
            <parameter name="privateKeyPem" allow-html="true"/>
            <parameter name="isActive"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages"><parameter name="message"/></parameter>
            <parameter name="errors"><parameter name="error"/></parameter>
            <parameter name="savedAuthConfig">
                <parameter name="nsAuthConfigId"/>
                <parameter name="description"/>
                <parameter name="authType"/>
                <parameter name="username"/>
                <parameter name="tokenUrl"/>
                <parameter name="clientId"/>
                <parameter name="certId"/>
                <parameter name="scope"/>
                <parameter name="isActive"/>
                <parameter name="hasPassword" type="Boolean"/>
                <parameter name="hasApiToken" type="Boolean"/>
                <parameter name="hasPrivateKeyPem" type="Boolean"/>
            </parameter>
        </out-parameters>
        <actions>
            <set field="nsAuthConfigIdValue" from="darpan.facade.common.FacadeSupport.normalize(nsAuthConfigId)"/>
            <set field="nsAuthDescriptionValue" from="darpan.facade.common.FacadeSupport.normalize(description)"/>
            <set field="nsAuthTypeValue" from="darpan.facade.common.FacadeSupport.normalize(authType)?.toUpperCase() ?: 'NONE'"/>
            <set field="nsUsernameValue" from="darpan.facade.common.FacadeSupport.normalize(username)"/>
            <set field="nsPasswordValue" from="darpan.facade.common.FacadeSupport.normalize(password)"/>
            <set field="nsApiTokenValue" from="darpan.facade.common.FacadeSupport.normalize(apiToken)"/>
            <set field="nsTokenUrlValue" from="darpan.facade.common.FacadeSupport.normalize(tokenUrl)"/>
            <set field="nsClientIdValue" from="darpan.facade.common.FacadeSupport.normalize(clientId)"/>
            <set field="nsCertIdValue" from="darpan.facade.common.FacadeSupport.normalize(certId)"/>
            <set field="nsScopeValue" from="darpan.facade.common.FacadeSupport.normalize(scope) ?: 'restlets rest_webservices'"/>
            <set field="nsPrivateKeyPemValue" from="darpan.facade.common.FacadeSupport.normalize(privateKeyPem)"/>
            <set field="nsIsActiveValue" from="darpan.facade.common.FacadeSupport.normalizeBool(isActive, true) ? 'Y' : 'N'"/>
            <if condition="!nsAuthConfigIdValue">
                <message error="true">Auth Config ID is required.</message>
            </if>
            <if condition="!['NONE', 'BASIC', 'BEARER', 'OAUTH2_M2M_JWT'].contains(nsAuthTypeValue)">
                <message error="true">Auth Type must be NONE, BASIC, BEARER, or OAUTH2_M2M_JWT.</message>
            </if>
            <if condition="nsAuthTypeValue == 'BASIC' &amp;&amp; !nsUsernameValue">
                <message error="true">Username is required for BASIC auth.</message>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="existingAuth" from="ec.entity.find('darpan.reconciliation.NsAuthConfig').condition('nsAuthConfigId', nsAuthConfigIdValue).useCache(false).one()"/>
            </if>
            <if condition="!ec.message.hasError()">
                <if condition="nsAuthTypeValue == 'OAUTH2_M2M_JWT' &amp;&amp; !nsTokenUrlValue">
                    <message error="true">Token URL is required for OAUTH2_M2M_JWT auth.</message>
                </if>
                <if condition="nsAuthTypeValue == 'OAUTH2_M2M_JWT' &amp;&amp; !nsClientIdValue">
                    <message error="true">Client ID is required for OAUTH2_M2M_JWT auth.</message>
                </if>
                <if condition="nsAuthTypeValue == 'OAUTH2_M2M_JWT' &amp;&amp; !nsCertIdValue">
                    <message error="true">Cert ID is required for OAUTH2_M2M_JWT auth.</message>
                </if>
                <if condition="nsAuthTypeValue == 'OAUTH2_M2M_JWT' &amp;&amp; !nsPrivateKeyPemValue &amp;&amp; !existingAuth?.privateKeyPem">
                    <message error="true">Private Key PEM is required for OAUTH2_M2M_JWT auth.</message>
                </if>
                <if condition="nsAuthTypeValue == 'BEARER' &amp;&amp; !nsApiTokenValue &amp;&amp; !nsPasswordValue &amp;&amp; !existingAuth?.apiToken &amp;&amp; !existingAuth?.password">
                    <message>Provide API Token (or password fallback) for BEARER auth.</message>
                </if>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="authMap" from="[nsAuthConfigId: nsAuthConfigIdValue, description: nsAuthDescriptionValue, authType: nsAuthTypeValue, username: nsUsernameValue, tokenUrl: nsTokenUrlValue, clientId: nsClientIdValue, certId: nsCertIdValue, scope: nsScopeValue, isActive: nsIsActiveValue, password: nsPasswordValue ?: existingAuth?.password, apiToken: nsApiTokenValue ?: existingAuth?.apiToken, privateKeyPem: nsPrivateKeyPemValue ?: existingAuth?.privateKeyPem]"/>
                <service-call name="store#darpan.reconciliation.NsAuthConfig" in-map="authMap"/>
                <set field="savedAuthConfig" from="[nsAuthConfigId: nsAuthConfigIdValue, description: nsAuthDescriptionValue, authType: nsAuthTypeValue, username: nsUsernameValue, tokenUrl: nsTokenUrlValue, clientId: nsClientIdValue, certId: nsCertIdValue, scope: nsScopeValue, isActive: nsIsActiveValue, hasPassword: !!darpan.facade.common.FacadeSupport.normalize(authMap.password), hasApiToken: !!darpan.facade.common.FacadeSupport.normalize(authMap.apiToken), hasPrivateKeyPem: !!darpan.facade.common.FacadeSupport.normalize(authMap.privateKeyPem)]"/>
                <if condition="!ec.message.hasError()">
                    <message>Saved NS Auth config ${nsAuthConfigIdValue}.</message>
                </if>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="list" noun="NsRestletConfigs" allow-remote="false" authenticate="true">
        <description>List NetSuite endpoint configs joined with auth metadata.</description>
        <in-parameters>
            <parameter name="query"/>
            <parameter name="pageIndex" type="Integer" default-value="0"/>
            <parameter name="pageSize" type="Integer" default-value="20"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages"><parameter name="message"/></parameter>
            <parameter name="errors"><parameter name="error"/></parameter>
            <parameter name="pagination">
                <parameter name="pageIndex" type="Integer"/>
                <parameter name="pageSize" type="Integer"/>
                <parameter name="totalCount" type="Integer"/>
                <parameter name="pageCount" type="Integer"/>
            </parameter>
            <parameter name="restletConfigs">
                <parameter name="nsRestletConfigId"/>
                <parameter name="description"/>
                <parameter name="endpointUrl"/>
                <parameter name="httpMethod"/>
                <parameter name="nsAuthConfigId"/>
                <parameter name="authDescription"/>
                <parameter name="authType"/>
                <parameter name="authIsActive"/>
                <parameter name="headersJson"/>
                <parameter name="connectTimeoutSeconds" type="Integer"/>
                <parameter name="readTimeoutSeconds" type="Integer"/>
                <parameter name="isActive"/>
            </parameter>
        </out-parameters>
        <actions>
            <set field="pageIndexSafe" from="Math.max(0, darpan.facade.common.FacadeSupport.normalizeInt(pageIndex, 0))"/>
            <set field="pageSizeSafe" from="Math.max(1, Math.min(200, darpan.facade.common.FacadeSupport.normalizeInt(pageSize, 20)))"/>
            <set field="searchLower" from="darpan.facade.common.FacadeSupport.normalize(query)?.toLowerCase()"/>
            <set field="restletConfigs" from="[]"/>
            <set field="pagination" from="[pageIndex: pageIndexSafe, pageSize: pageSizeSafe, totalCount: 0, pageCount: 1]"/>
            <entity-find entity-name="darpan.reconciliation.NsAuthConfig" list="authConfigList" cache="false"/>
            <entity-find entity-name="darpan.reconciliation.NsRestletConfig" list="nsRestletConfigList" cache="false">
                <order-by field-name="description,nsRestletConfigId"/>
            </entity-find>
            <set field="authById" from="(authConfigList ?: []).collectEntries { cfg -> [(cfg.nsAuthConfigId): [description: cfg.description, authType: cfg.authType, isActive: cfg.isActive]] }"/>
            <set field="rows" from="(nsRestletConfigList ?: []).collect { cfg -> def authMeta = authById[cfg.nsAuthConfigId]; [nsRestletConfigId: cfg.nsRestletConfigId, description: cfg.description, endpointUrl: cfg.endpointUrl, httpMethod: cfg.httpMethod ?: 'POST', nsAuthConfigId: cfg.nsAuthConfigId, authDescription: authMeta?.description, authType: authMeta?.authType, authIsActive: authMeta?.isActive ?: 'Y', headersJson: cfg.headersJson, connectTimeoutSeconds: cfg.connectTimeoutSeconds ?: 30, readTimeoutSeconds: cfg.readTimeoutSeconds ?: 60, isActive: cfg.isActive ?: 'Y'] }"/>
            <set field="filteredRows" from="searchLower ? rows.findAll { row -> [row.nsRestletConfigId, row.description, row.endpointUrl, row.nsAuthConfigId, row.authType].any { it?.toString()?.toLowerCase()?.contains(searchLower) } } : rows"/>
            <set field="totalCount" from="filteredRows.size()"/>
            <set field="fromIndex" from="Math.min(pageIndexSafe * pageSizeSafe, totalCount)"/>
            <set field="toIndex" from="Math.min(fromIndex + pageSizeSafe, totalCount)"/>
            <set field="restletConfigs" from="filteredRows.subList(fromIndex, toIndex)"/>
            <set field="pagination" from="[pageIndex: pageIndexSafe, pageSize: pageSizeSafe, totalCount: totalCount, pageCount: Math.max(1, ((totalCount + pageSizeSafe - 1) / pageSizeSafe) as int)]"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="save" noun="NsRestletConfig" allow-remote="false" authenticate="true">
        <description>Create or update a NetSuite endpoint configuration bound to an auth config.</description>
        <in-parameters>
            <parameter name="nsRestletConfigId" required="true"/>
            <parameter name="description"/>
            <parameter name="endpointUrl" required="true"/>
            <parameter name="httpMethod" default-value="POST"/>
            <parameter name="nsAuthConfigId" required="true"/>
            <parameter name="headersJson" allow-html="true"/>
            <parameter name="connectTimeoutSeconds" type="Integer" default-value="30"/>
            <parameter name="readTimeoutSeconds" type="Integer" default-value="60"/>
            <parameter name="isActive"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages"><parameter name="message"/></parameter>
            <parameter name="errors"><parameter name="error"/></parameter>
            <parameter name="savedRestletConfig">
                <parameter name="nsRestletConfigId"/>
                <parameter name="description"/>
                <parameter name="endpointUrl"/>
                <parameter name="httpMethod"/>
                <parameter name="nsAuthConfigId"/>
                <parameter name="headersJson"/>
                <parameter name="connectTimeoutSeconds" type="Integer"/>
                <parameter name="readTimeoutSeconds" type="Integer"/>
                <parameter name="isActive"/>
            </parameter>
        </out-parameters>
        <actions>
            <set field="nsRestletConfigIdValue" from="darpan.facade.common.FacadeSupport.normalize(nsRestletConfigId)"/>
            <set field="nsDescriptionValue" from="darpan.facade.common.FacadeSupport.normalize(description)"/>
            <set field="nsEndpointUrlValue" from="darpan.facade.common.FacadeSupport.normalize(endpointUrl)"/>
            <set field="nsHttpMethodValue" from="darpan.facade.common.FacadeSupport.normalize(httpMethod)?.toUpperCase() ?: 'POST'"/>
            <set field="nsAuthConfigIdValue" from="darpan.facade.common.FacadeSupport.normalize(nsAuthConfigId)"/>
            <set field="nsHeadersJsonValue" from="darpan.facade.common.FacadeSupport.normalize(headersJson)"/>
            <set field="nsConnectTimeoutValue" from="darpan.facade.common.FacadeSupport.normalizeInt(connectTimeoutSeconds, 30)"/>
            <set field="nsReadTimeoutValue" from="darpan.facade.common.FacadeSupport.normalizeInt(readTimeoutSeconds, 60)"/>
            <set field="nsIsActiveValue" from="darpan.facade.common.FacadeSupport.normalizeBool(isActive, true) ? 'Y' : 'N'"/>
            <set field="headersJsonError" from="darpan.facade.settings.SettingsFacadeSupport.validateJsonObjectText(nsHeadersJsonValue, 'Headers JSON')"/>
            <if condition="!nsRestletConfigIdValue">
                <message error="true">Endpoint Config ID is required.</message>
            </if>
            <if condition="!nsEndpointUrlValue">
                <message error="true">Endpoint URL is required.</message>
            </if>
            <if condition="!['POST', 'PUT', 'GET'].contains(nsHttpMethodValue)">
                <message error="true">HTTP Method must be POST, PUT, or GET.</message>
            </if>
            <if condition="!nsAuthConfigIdValue">
                <message error="true">Auth Config ID is required.</message>
            </if>
            <if condition="nsConnectTimeoutValue &lt;= 0">
                <set field="nsConnectTimeoutValue" from="30"/>
            </if>
            <if condition="nsReadTimeoutValue &lt;= 0">
                <set field="nsReadTimeoutValue" from="60"/>
            </if>
            <if condition="headersJsonError">
                <message error="true">${headersJsonError}</message>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="authCfg" from="ec.entity.find('darpan.reconciliation.NsAuthConfig').condition('nsAuthConfigId', nsAuthConfigIdValue).useCache(false).one()"/>
                <if condition="!authCfg">
                    <message error="true">NsAuthConfig ${nsAuthConfigIdValue} not found.</message>
                </if>
                <if condition="authCfg &amp;&amp; (authCfg.isActive ?: 'Y').toString().equalsIgnoreCase('N')">
                    <message error="true">NsAuthConfig ${nsAuthConfigIdValue} is inactive.</message>
                </if>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="endpointMap" from="[nsRestletConfigId: nsRestletConfigIdValue, description: nsDescriptionValue, endpointUrl: nsEndpointUrlValue, httpMethod: nsHttpMethodValue, nsAuthConfigId: nsAuthConfigIdValue, headersJson: nsHeadersJsonValue, connectTimeoutSeconds: nsConnectTimeoutValue, readTimeoutSeconds: nsReadTimeoutValue, isActive: nsIsActiveValue, authType: null, username: null, password: null, apiToken: null, tokenUrl: null, clientId: null, certId: null, privateKeyPem: null, scope: null]"/>
                <service-call name="store#darpan.reconciliation.NsRestletConfig" in-map="endpointMap"/>
                <set field="savedRestletConfig" from="[nsRestletConfigId: nsRestletConfigIdValue, description: nsDescriptionValue, endpointUrl: nsEndpointUrlValue, httpMethod: nsHttpMethodValue, nsAuthConfigId: nsAuthConfigIdValue, headersJson: nsHeadersJsonValue, connectTimeoutSeconds: nsConnectTimeoutValue, readTimeoutSeconds: nsReadTimeoutValue, isActive: nsIsActiveValue]"/>
                <if condition="!ec.message.hasError()">
                    <message>Saved NS endpoint config ${nsRestletConfigIdValue}.</message>
                </if>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

</services>
